@using Microsoft.Extensions.Localization
@using NowFound.Web.Resources
@inject IStringLocalizer<AccountResource> L
@model ChangePasswordViewModel
@{
    ViewData["Title"] = L["ChangePassword.Title"].Value;
}
<div class="card">
    <h1>@L["ChangePassword.Title"]</h1>
    @if (ViewData["Expired"] is true)
    {
        <p class="notice" role="status">@L["ChangePassword.Expired"]</p>
    }
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="field">
            <label asp-for="CurrentPassword">@L["ChangePassword.Current"]</label>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
        </div>
        <div class="field">
            <label asp-for="NewPassword">@L["ChangePassword.New"]</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
            <partial name="_PasswordHint" />
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">@L["ChangePassword.Confirm"]</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>
        <button type="submit">@L["ChangePassword.Submit"]</button>
    </form>
</div>
