@using Microsoft.Extensions.Localization
@using NowFound.Web.Resources
@model ErrorViewModel
@inject IStringLocalizer<CommonResource> L
@{
    ViewData["Title"] = L["Error.Title"].Value;
}

<h1 class="text-danger">@L["Error.Heading"]</h1>
<h2 class="text-danger">@L["Error.Message"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["Error.RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}
