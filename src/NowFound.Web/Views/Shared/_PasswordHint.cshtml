@using Microsoft.Extensions.Localization
@using NowFound.Web.Resources
@inject IStringLocalizer<CommonResource> C
@inject IAccountPolicyStore PolicyStore
@{
    var policy = PolicyStore.Current;
}
<p class="muted">
    @C["Password.Hint", policy.PasswordMinLength]@if (policy.RequireComplexity)
    {
        @C["Password.Hint.Complexity", AccountPolicy.MinCategories]
    }
</p>
