@using Microsoft.Extensions.Localization
@using NowFound.Web.Resources
@model SortLinkModel
@inject IStringLocalizer<CommonResource> C
<a class="sort-link@(Model.Active ? " active" : "")" href="@Model.Url" title="@C["List.SortBy", Model.Label]">@Model.Label@(Model.Active ? (Model.Descending ? " ▼" : " ▲") : "")</a>
