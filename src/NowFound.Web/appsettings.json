{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": { "MainDb": "Data Source=../data/main.db", "FilesDb": "Data Source=../data/files.db", "OperationLogDb": "Data Source=../data/ope.db" },
  "Database": { "SeedData": false },
  "PathBase": "",
  "ForwardedHeaders": { "KnownProxies": [] },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
